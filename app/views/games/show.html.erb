<div class="container mx-auto p-4">
  <%# Game Header %>
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= @game.title %></h1>
    <%= link_to "← back", games_path, class: "text-gray-400 hover:text-white" %>
  </div>

  <%# Game Container %>
  <div class="bg-gray-800 rounded-lg p-4"
    data-controller="game"
    data-game-code-value="<%= @game.code %>"
    data-game-id-value="<%= @game.id %>">
    <%# Game Canvas %>
    <canvas data-game-target="canvas"
      width="400"
      height="400"
      class="mx-auto bg-gray-900 rounded-lg">
    </canvas>
    <%# Controls %>
    <div class="flex justify-center gap-4 mt-4">
      <button data-action="click->game#start" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition cursor-pointer">
        ▶ Start Game
      </button>
      <button data-action="click->game#restart" class="px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition cursor-pointer">
        ⟳ Reset Game
      </button>
    </div>
    <%# Score %>
    <div class="text-center mt-4">
        <span class="text-2xl font-bold text-white">
          Score: <span data-game-target="score">0</span>
        </span>
    </div>
  </div>
  <%# Game Info  %>
  <div class="mt-6 text-gray-400">
    <p><strong>Difficulty:</strong> <%= "⭐" * @game.difficulty %></p>
    <p><strong>Duration:</strong> <%= @game.duration %> seconds</p>
    <% if @game.description.present? %>
      <p class="mt-2"><%= @game.description %></p>
    <% end %>
  </div>
</div>
