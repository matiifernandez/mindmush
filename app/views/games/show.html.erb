<div class="container mx-auto px-4 py-8 max-w-5xl">
  <%# Game Header %>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-slate-100"><%= @game.title %></h1>
    <%= link_to games_path, class: "text-slate-400 hover:text-white transition flex items-center gap-1" do %>
      <span>←</span> Back to games
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Game Container - Main Column %>
    <div class="lg:col-span-2 space-y-4">
      <div class="bg-slate-800/50 rounded-2xl p-6 border border-slate-700/50"
        data-controller="game"
        data-game-code-value="<%= @game.code %>"
        data-game-id-value="<%= @game.id %>">
        <%# Game Canvas %>
        <canvas data-game-target="canvas"
          width="400"
          height="400"
          class="mx-auto rounded-xl shadow-lg shadow-black/50">
        </canvas>
        <%# Controls %>
        <div class="flex justify-center gap-4 mt-6">
          <button data-action="click->game#start" class="px-8 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-semibold rounded-xl hover:from-emerald-600 hover:to-emerald-700 transition-all hover:scale-105 cursor-pointer">
            ▶ Start
          </button>
          <button data-action="click->game#restart" class="px-8 py-3 bg-slate-700 text-slate-200 font-semibold rounded-xl hover:bg-slate-600 transition-all cursor-pointer border border-slate-600">
            ⟳ Reset
          </button>
        </div>
        <%# Score %>
        <div class="text-center mt-6">
          <span class="text-3xl font-bold text-slate-100">
            Score: <span data-game-target="score" class="text-rose-400">0</span>
          </span>
        </div>
      </div>

      <%# Vote & Stats Bar %>
      <div class="flex flex-wrap justify-center items-center gap-4 bg-slate-800/50 rounded-2xl p-4 border border-slate-700/50">
        <% if user_signed_in? %>
          <%= button_to vote_game_path(@game.slug, value: 1), method: :post, class: "flex items-center gap-2 px-5 py-2.5 rounded-xl transition-all #{@user_vote&.value == 1 ? 'bg-emerald-500 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600'}" do %>
            <span class="text-xl">👍</span>
            <span class="font-semibold"><%= @game.likes_count %></span>
          <% end %>

          <%= button_to vote_game_path(@game.slug, value: -1), method: :post, class: "flex items-center gap-2 px-5 py-2.5 rounded-xl transition-all #{@user_vote&.value == -1 ? 'bg-rose-500 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600'}" do %>
            <span class="text-xl">👎</span>
            <span class="font-semibold"><%= @game.dislikes_count %></span>
          <% end %>
        <% else %>
          <div class="flex items-center gap-4 text-slate-400">
            <span class="flex items-center gap-2 bg-slate-700/50 px-4 py-2 rounded-xl">👍 <%= @game.likes_count %></span>
            <span class="flex items-center gap-2 bg-slate-700/50 px-4 py-2 rounded-xl">👎 <%= @game.dislikes_count %></span>
            <span class="text-sm">(<%= link_to "Login to vote", new_user_session_path, class: "text-rose-400 hover:underline" %>)</span>
          </div>
        <% end %>

        <div class="h-6 w-px bg-slate-700 hidden sm:block"></div>
        <span class="text-slate-400 flex items-center gap-2">
          <span class="text-lg">▶</span> <%= @game.play_count %> plays
        </span>
      </div>

      <%# Game Info %>
      <div class="bg-slate-800/50 rounded-2xl p-5 border border-slate-700/50">
        <div class="flex flex-wrap gap-4 text-sm">
          <span class="bg-slate-700/50 px-3 py-1.5 rounded-lg">
            <span class="text-slate-400">Difficulty:</span>
            <span class="text-amber-400 ml-1"><%= "⭐" * @game.difficulty %></span>
          </span>
          <span class="bg-slate-700/50 px-3 py-1.5 rounded-lg">
            <span class="text-slate-400">Duration:</span>
            <span class="text-slate-200 ml-1"><%= @game.duration %>s</span>
          </span>
          <% if @game.creator %>
            <%= link_to user_profile_path(@game.creator.username), class: "bg-slate-700/50 px-3 py-1.5 rounded-lg hover:bg-slate-600/50 transition" do %>
              <span class="text-slate-400">Created by:</span>
              <span class="text-violet-400 ml-1"><%= @game.creator.username %></span>
            <% end %>
          <% end %>
        </div>
        <% if @game.description.present? %>
          <p class="mt-4 text-slate-300 leading-relaxed"><%= @game.description %></p>
        <% end %>
      </div>
    </div>

    <%# Sidebar - Leaderboard %>
    <div class="lg:col-span-1">
      <div class="bg-slate-800/50 rounded-2xl p-5 border border-slate-700/50 sticky top-20">
        <h2 class="text-lg font-bold text-slate-100 mb-4 flex items-center gap-2">
          <span>🏆</span> Leaderboard
        </h2>
        <% if @leaderboard.any? %>
          <ol class="space-y-2">
            <% @leaderboard.each_with_index do |entry, index| %>
              <li class="flex justify-between items-center p-3 rounded-xl <%= index < 3 ? 'bg-slate-700/50' : '' %>">
                <span class="flex items-center gap-3">
                  <span class="text-lg <%= index == 0 ? 'text-amber-400' : index == 1 ? 'text-slate-300' : index == 2 ? 'text-amber-600' : 'text-slate-500' %>">
                    <%= index == 0 ? '🥇' : index == 1 ? '🥈' : index == 2 ? '🥉' : "#{index + 1}." %>
                  </span>
                  <%= link_to entry.user.username, user_profile_path(entry.user.username), class: "text-slate-200 font-medium hover:text-violet-400 transition" %>
                </span>
                <span class="font-bold text-rose-400"><%= number_with_delimiter(entry.best_score) %></span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <div class="text-center py-8">
            <div class="text-4xl mb-3">🎯</div>
            <p class="text-slate-500">No scores yet.<br>Be the first!</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
