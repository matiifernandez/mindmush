<div class="container mx-auto p-4 max-w-4xl">
  <%# Game Header %>
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= @game.title %></h1>
    <%= link_to "← back", games_path, class: "text-gray-400 hover:text-white" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Game Container - Main Column %>
    <div class="lg:col-span-2">
      <div class="bg-gray-800 rounded-lg p-4"
        data-controller="game"
        data-game-code-value="<%= @game.code %>"
        data-game-id-value="<%= @game.id %>">
        <%# Game Canvas %>
        <canvas data-game-target="canvas"
          width="400"
          height="400"
          class="mx-auto bg-gray-900 rounded-lg">
        </canvas>
        <%# Controls %>
        <div class="flex justify-center gap-4 mt-4">
          <button data-action="click->game#start" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition cursor-pointer">
            ▶ Start
          </button>
          <button data-action="click->game#restart" class="px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition cursor-pointer">
            ⟳ Reset
          </button>
        </div>
        <%# Score %>
        <div class="text-center mt-4">
          <span class="text-2xl font-bold text-white">
            Score: <span data-game-target="score">0</span>
          </span>
        </div>
      </div>

      <%# Vote Buttons %>
      <div class="flex justify-center items-center gap-6 mt-4 bg-gray-800 rounded-lg p-4">
        <% if user_signed_in? %>
          <%= button_to vote_game_path(@game.slug, value: 1), method: :post, class: "flex items-center gap-2 px-4 py-2 rounded-lg transition #{@user_vote&.value == 1 ? 'bg-green-600 text-white' : 'bg-gray-700 text-gray-300 hover:bg-gray-600'}" do %>
            <span class="text-xl">👍</span>
            <span><%= @game.likes_count %></span>
          <% end %>

          <%= button_to vote_game_path(@game.slug, value: -1), method: :post, class: "flex items-center gap-2 px-4 py-2 rounded-lg transition #{@user_vote&.value == -1 ? 'bg-red-600 text-white' : 'bg-gray-700 text-gray-300 hover:bg-gray-600'}" do %>
            <span class="text-xl">👎</span>
            <span><%= @game.dislikes_count %></span>
          <% end %>
        <% else %>
          <div class="flex items-center gap-6 text-gray-400">
            <span class="flex items-center gap-2">👍 <%= @game.likes_count %></span>
            <span class="flex items-center gap-2">👎 <%= @game.dislikes_count %></span>
            <span class="text-sm">(<%= link_to "Login to vote", new_user_session_path, class: "text-pink-400 hover:underline" %>)</span>
          </div>
        <% end %>

        <span class="text-gray-500">|</span>
        <span class="text-gray-400">▶ <%= @game.play_count %> plays</span>
      </div>

      <%# Game Info %>
      <div class="mt-4 bg-gray-800 rounded-lg p-4 text-gray-400">
        <div class="flex gap-6 text-sm">
          <span><strong>Difficulty:</strong> <%= "⭐" * @game.difficulty %></span>
          <span><strong>Duration:</strong> <%= @game.duration %>s</span>
          <% if @game.creator %>
            <span><strong>By:</strong> <%= @game.creator.username %></span>
          <% end %>
        </div>
        <% if @game.description.present? %>
          <p class="mt-2"><%= @game.description %></p>
        <% end %>
      </div>
    </div>

    <%# Sidebar - Leaderboard %>
    <div class="lg:col-span-1">
      <div class="bg-gray-800 rounded-lg p-4">
        <h2 class="text-lg font-bold mb-4">🏆 Leaderboard</h2>
        <% if @leaderboard.any? %>
          <ol class="space-y-2">
            <% @leaderboard.each_with_index do |entry, index| %>
              <li class="flex justify-between items-center p-2 rounded <%= index < 3 ? 'bg-gray-700' : '' %>">
                <span class="flex items-center gap-2">
                  <span class="<%= index == 0 ? 'text-yellow-400' : index == 1 ? 'text-gray-300' : index == 2 ? 'text-amber-600' : 'text-gray-500' %>">
                    <%= index == 0 ? '🥇' : index == 1 ? '🥈' : index == 2 ? '🥉' : "#{index + 1}." %>
                  </span>
                  <span class="text-white"><%= entry.user.username %></span>
                </span>
                <span class="font-bold text-pink-400"><%= entry.best_score %></span>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="text-gray-500 text-center py-4">No scores yet. Be the first!</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
