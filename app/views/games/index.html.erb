<div class="container mx-auto p-8">
  <h1 class="text-3xl font-bold mb-6"> 🎮 Top Games</h1>

  <%= link_to "Play Random Game", random_games_path, class: "inline-block mb-6 px-6 py-3 bg-pink-600 text-white rounded-lg hover:bg-pink-700 transition" %>
  <% if @games.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @games.each do |game| %>
        <%= link_to game_path(game.slug), class: "block p-6 bg-gray-800 rounded-lg hover:bg-gray-700 transition" do %>
          <h2 class="text-xl font-semibold text-white mb-2"><%= game.title %></h2>
          <p class="text-gray-400 text-sm mb-3"><%= truncate(game.description, length: 100) %></p>
          <div class="flex justify-between text-sm text-gray-500">
            <span>🎯 <%= game.play_count %> plays</span>
            <span>⭐️ <%= game.difficulty %>/5</span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
      <p class="text-gray-400">No games available at the moment. Please check back later!</p>
  <% end %>
</div>
