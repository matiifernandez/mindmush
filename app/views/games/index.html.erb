<div class="container mx-auto px-4 py-10 max-w-6xl">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-slate-100">🎮 All Games</h1>
    <div class="flex gap-3">
      <%= link_to random_games_path, class: "px-4 py-2 bg-gradient-to-r from-rose-500 to-rose-600 text-white font-medium rounded-xl hover:from-rose-600 hover:to-rose-700 transition-all hover:scale-105" do %>
        🎲 Random
      <% end %>
      <% if user_signed_in? %>
        <%= link_to generator_path, class: "px-4 py-2 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white font-medium rounded-xl hover:from-violet-600 hover:to-fuchsia-600 transition-all hover:scale-105" do %>
          ✨ Create
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @games.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @games.each do |game| %>
        <%= link_to game_path(game.slug), class: "group block bg-slate-800/50 rounded-2xl p-5 border border-slate-700/50 hover:border-rose-500/50 hover:bg-slate-800 transition-all" do %>
          <h2 class="text-lg font-semibold text-slate-100 mb-2 group-hover:text-rose-400 transition"><%= game.title %></h2>
          <p class="text-slate-400 text-sm mb-4 line-clamp-2"><%= game.description.presence || "No description" %></p>

          <div class="flex items-center justify-between text-sm mb-3">
            <span class="text-amber-400"><%= "⭐" * game.difficulty %></span>
            <span class="text-slate-500">▶ <%= game.play_count %> plays</span>
          </div>

          <div class="flex items-center gap-4 pt-3 border-t border-slate-700/50 text-sm">
            <span class="text-emerald-400">👍 <%= game.likes_count %></span>
            <span class="text-rose-400">👎 <%= game.dislikes_count %></span>
            <% if game.creator %>
              <span class="text-slate-500 ml-auto">by <span class="text-slate-400"><%= game.creator.username %></span></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-slate-800/30 rounded-2xl border border-slate-700/50">
      <div class="text-5xl mb-4">🎮</div>
      <p class="text-slate-400 text-lg mb-6">No games available yet.</p>
      <% if user_signed_in? %>
        <%= link_to generator_path, class: "inline-block px-6 py-3 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white font-semibold rounded-xl hover:from-violet-600 hover:to-fuchsia-600 transition-all" do %>
          ✨ Create the first game!
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
