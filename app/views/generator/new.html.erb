<div class="container mx-auto p-8 max-w-4xl">
  <h1 class="text-3xl font-bold mb-6">Create your own game with AI 🤖</h1>

  <!-- Prompt form -->
  <div class="bg-gray-800 rounded-lg p-6 mb-6" data-controller="generator">
    <label class="block text-white text-lg mb-2">Describe the game you want to create:</label>
    <textarea
      data-generator-target="prompt"
      class="w-full p-4 bg-gray-900 text-white rounded-lg border border-gray-700 focus:border-pink-500 focus:outline-none"
      rows="4"
      placeholder="E.g., A game where fruits fall from the sky and you have to catch them with a basket..."></textarea>

    <button
      data-action="click->generator#generate"
      data-generator-target="generateBtn"
      class="mt-4 px-6 py-3 bg-pink-600 text-white rounded-lg hover:bg-pink-700 transition">
      🎮 Generate Game
    </button>

    <div data-generator-target="loading" class="hidden mt-4 text-yellow-400">
      ⏳ Generating game... this may take a few seconds...
    </div>

    <div data-generator-target="error" class="hidden mt-4 text-red-400">
    </div>

    <!-- Game Preview -->
    <div data-generator-target="preview" class="hidden mt-6">
      <h2 class="text-xl font-bold mb-4">Preview</h2>

      <div class="bg-gray-900 rounded-lg p-4 mb-4">
        <canvas
          data-generator-target="canvas"
          width="400"
          height="400"
          class="mx-auto bg-gray-900 rounded-lg">
        </canvas>

        <div class="flex justify-center gap-4 mt-4">
          <button
            data-action="click->generator#testGame"
            class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition">
            ▶ Test Game
          </button>
          <button
            data-action="click->generator#regenerate"
            class="px-6 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition">
            🔄 Try again
          </button>
        </div>
      </div>

      <!-- Save form -->
      <div class="bg-gray-700 rounded-lg p-4">
        <h3 class="text-lg font-bold mb-4">Save Game</h3>

        <%= simple_form_for :game, url: generator_create_path, method: :post do |f| %>
          <%= f.input :title,
              required: true,
              input_html: { class: "w-full p-2 bg-gray-900 text-white rounded border border-gray-600 focus:border-pink-500 focus:outline-none" },
              label_html: { class: "block mb-1 text-white" } %>

          <%= f.input :description,
              as: :text,
              input_html: { rows: 2, class: "w-full p-2 bg-gray-900 text-white rounded border border-gray-600 focus:border-pink-500 focus:outline-none" },
              label_html: { class: "block mb-1 text-white" } %>

          <div class="flex gap-4">
            <%= f.input :difficulty,
                as: :select,
                collection: [["⭐ Easy", 1], ["⭐⭐ Normal", 2], ["⭐⭐⭐ Hard", 3]],
                selected: 2,
                input_html: { class: "w-full p-2 bg-gray-900 text-white rounded border border-gray-600" },
                label_html: { class: "block mb-1 text-white" },
                wrapper_html: { class: "flex-1" } %>

            <%= f.input :duration,
                as: :integer,
                input_html: { value: 30, min: 10, max: 120, class: "w-full p-2 bg-gray-900 text-white rounded border border-gray-600 focus:border-pink-500 focus:outline-none" },
                label_html: { class: "block mb-1 text-white" },
                wrapper_html: { class: "flex-1" } %>
          </div>

          <input type="hidden" name="code" data-generator-target="codeInput">
          <input type="hidden" name="prompt" data-generator-target="promptInput">

          <%= f.button :submit, "💾 Save Game",
              class: "w-full px-6 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition mt-4" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
