<div class="container mx-auto px-4 py-10 max-w-4xl">
  <h1 class="text-3xl font-bold text-slate-100 mb-2">✨ Create with AI</h1>
  <p class="text-slate-400 mb-8">Describe your game idea and let AI bring it to life</p>

  <div class="bg-slate-800/50 rounded-2xl p-6 border border-slate-700/50" data-controller="generator">
    <label class="block text-lg text-slate-200 mb-3">What kind of game do you want to create?</label>
    <textarea
      data-generator-target="prompt"
      class="w-full p-4 bg-slate-900 text-slate-100 rounded-xl border border-slate-700 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20 transition placeholder-slate-500"
      rows="4"
      placeholder="E.g., A space shooter where you dodge asteroids using arrow keys, collect power-ups, and try to survive as long as possible..."></textarea>

    <button
      data-action="click->generator#generate"
      data-generator-target="generateBtn"
      class="mt-4 px-6 py-3 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white font-semibold rounded-xl hover:from-violet-600 hover:to-fuchsia-600 transition-all hover:scale-105">
      🎮 Generate Game
    </button>

    <div data-generator-target="loading" class="hidden mt-4 text-amber-400 flex items-center gap-2">
      <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Generating your game... this may take a few seconds
    </div>

    <div data-generator-target="error" class="hidden mt-4 text-rose-400 bg-rose-500/10 p-3 rounded-lg">
    </div>

    <%# Game Preview %>
    <div data-generator-target="preview" class="hidden mt-8">
      <h2 class="text-xl font-bold text-slate-100 mb-4">🎯 Preview</h2>

      <div class="bg-slate-900 rounded-xl p-6 mb-6">
        <canvas
          data-generator-target="canvas"
          width="400"
          height="400"
          class="mx-auto rounded-xl shadow-lg shadow-black/50">
        </canvas>

        <div class="flex justify-center gap-4 mt-6">
          <button
            data-action="click->generator#testGame"
            class="px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-semibold rounded-xl hover:from-emerald-600 hover:to-emerald-700 transition-all hover:scale-105">
            ▶ Test Game
          </button>
          <button
            data-action="click->generator#regenerate"
            class="px-6 py-3 bg-slate-700 text-slate-200 font-semibold rounded-xl hover:bg-slate-600 transition-all border border-slate-600">
            🔄 Regenerate
          </button>
        </div>
      </div>

      <%# Save form %>
      <div class="bg-slate-700/50 rounded-xl p-6 border border-slate-600/50">
        <h3 class="text-lg font-bold text-slate-100 mb-4">💾 Save Your Game</h3>

        <%= simple_form_for :game, url: generator_create_path, method: :post do |f| %>
          <%= f.input :title,
              required: true,
              input_html: { class: "w-full p-3 bg-slate-800 text-slate-100 rounded-lg border border-slate-600 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" },
              label_html: { class: "block mb-2 text-slate-200 font-medium" } %>

          <%= f.input :description,
              as: :text,
              input_html: { rows: 2, class: "w-full p-3 bg-slate-800 text-slate-100 rounded-lg border border-slate-600 focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-violet-500/20" },
              label_html: { class: "block mb-2 text-slate-200 font-medium" } %>

          <div class="flex gap-4">
            <%= f.input :difficulty,
                as: :select,
                collection: [["⭐ Easy", 1], ["⭐⭐ Normal", 2], ["⭐⭐⭐ Hard", 3]],
                selected: 2,
                input_html: { class: "w-full p-3 bg-slate-800 text-slate-100 rounded-lg border border-slate-600 focus:border-violet-500 focus:outline-none" },
                label_html: { class: "block mb-2 text-slate-200 font-medium" },
                wrapper_html: { class: "flex-1" } %>

            <%= f.input :duration,
                as: :integer,
                input_html: { value: 30, min: 10, max: 120, class: "w-full p-3 bg-slate-800 text-slate-100 rounded-lg border border-slate-600 focus:border-violet-500 focus:outline-none" },
                label_html: { class: "block mb-2 text-slate-200 font-medium" },
                wrapper_html: { class: "flex-1" } %>
          </div>

          <input type="hidden" name="code" data-generator-target="codeInput">
          <input type="hidden" name="prompt" data-generator-target="promptInput">

          <%= f.button :submit, "💾 Save Game",
              class: "w-full px-6 py-3 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white font-semibold rounded-xl hover:from-violet-600 hover:to-fuchsia-600 transition-all mt-4" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
