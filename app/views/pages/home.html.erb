<div class="container mx-auto p-8">
  <h1 class="text-4xl font-bold mb-4">Welcome to Mindmush 🧠</h1>

  <% if user_signed_in? %>
    <p class="mb-4">Hi, <strong><%= current_user.username %></strong>!</p>
    <p class="mb-2">Email: <%= current_user.email %></p>
    <%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-red-500 underline" %>
  <% else %>
    <p class="mb-4">You are not logged in</p>
    <%= link_to "Log in", new_user_session_path, class: "text-blue-500 underline mr-4" %>
    <%= link_to "Sign up", new_user_registration_path, class: "text-green-500 underline" %>
  <% end %>
</div>
