<div class="flex justify-center px-4 py-12 mt-8">
  <div class="w-full max-w-sm">
    <div class="bg-slate-800/50 rounded-2xl border border-slate-700 p-6">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-white mb-1">Create account</h1>
        <p class="text-slate-400 text-sm">Join MindMush and start playing</p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :username, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= f.text_field :username, autocomplete: "username",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "Choose a username" %>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "your@email.com" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-slate-500">(<%= @minimum_password_length %> characters minimum)</span>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "Create a password" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "Confirm your password" %>
        </div>

        <div class="flex justify-center pt-3">
          <%= f.submit "Create account",
              class: "px-8 py-2 bg-gradient-to-r from-rose-500 to-violet-500 text-white text-sm font-medium rounded-lg hover:from-rose-600 hover:to-violet-600 transition-all cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 pt-4 border-t border-slate-700 text-center">
        <p class="text-slate-400 text-sm">
          Already have an account?
          <%= link_to "Sign in", new_session_path(resource_name), class: "text-violet-400 hover:text-violet-300 font-medium transition" %>
        </p>
      </div>
    </div>
  </div>
</div>
