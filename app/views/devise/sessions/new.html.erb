<div class="flex justify-center px-4 py-12 mt-8">
  <div class="w-full max-w-sm">
    <div class="bg-slate-800/50 rounded-2xl border border-slate-700 p-6">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-white mb-1">Welcome back</h1>
        <p class="text-slate-400 text-sm">Sign in to continue playing</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "your@email.com" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "Your password" %>
        </div>

        <div class="flex items-center justify-between py-2">
          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-2 cursor-pointer group">
              <%= f.check_box :remember_me, class: "w-3.5 h-3.5 rounded border-slate-600 bg-slate-900/50 text-violet-500 focus:ring-violet-500 focus:ring-offset-0 cursor-pointer" %>
              <span class="text-xs text-slate-400 group-hover:text-slate-300 transition">Remember me</span>
            </label>
          <% else %>
            <div></div>
          <% end %>
          <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs text-violet-400 hover:text-violet-300 transition" %>
          <% end %>
        </div>

        <div class="flex justify-center pt-2">
          <%= f.submit "Sign in",
              class: "px-8 py-2 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white text-sm font-medium rounded-lg hover:from-violet-600 hover:to-fuchsia-600 transition-all cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 pt-4 border-t border-slate-700 text-center">
        <p class="text-slate-400 text-sm">
          Don't have an account?
          <%= link_to "Sign up", new_registration_path(resource_name), class: "text-rose-400 hover:text-rose-300 font-medium transition" %>
        </p>
      </div>
    </div>
  </div>
</div>
