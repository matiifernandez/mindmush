<div class="flex justify-center px-4 py-12 mt-8">
  <div class="w-full max-w-sm">
    <div class="bg-slate-800/50 rounded-2xl border border-slate-700 p-6">
      <div class="text-center mb-6">
        <div class="text-4xl mb-3">🔐</div>
        <h1 class="text-2xl font-bold text-white mb-1">Set new password</h1>
        <p class="text-slate-400 text-sm">Create a strong password</p>
      </div>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div>
          <%= f.label :password, "New password", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-slate-500">(<%= @minimum_password_length %> characters minimum)</span>
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "New password" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full px-3 py-2 bg-slate-900/50 border border-slate-600 rounded-lg text-white text-sm placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:border-transparent transition",
              placeholder: "Confirm password" %>
        </div>

        <div class="flex justify-center pt-3">
          <%= f.submit "Reset password",
              class: "px-8 py-2 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white text-sm font-medium rounded-lg hover:from-violet-600 hover:to-fuchsia-600 transition-all cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 pt-4 border-t border-slate-700 text-center">
        <p class="text-slate-400 text-sm">
          Remember your password?
          <%= link_to "Sign in", new_session_path(resource_name), class: "text-violet-400 hover:text-violet-300 font-medium transition" %>
        </p>
      </div>
    </div>
  </div>
</div>
