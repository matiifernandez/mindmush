<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8">
    <span class="text-rose-400">Admin</span> Dashboard
  </h1>

  <%# Stats Cards %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-slate-800/50 rounded-xl p-6 border border-slate-700">
      <div class="text-3xl font-bold text-white"><%= @total_users %></div>
      <div class="text-slate-400 text-sm">Total Users</div>
    </div>
    <div class="bg-slate-800/50 rounded-xl p-6 border border-slate-700">
      <div class="text-3xl font-bold text-white"><%= @total_games %></div>
      <div class="text-slate-400 text-sm">Total Games</div>
    </div>
    <div class="bg-slate-800/50 rounded-xl p-6 border border-slate-700">
      <div class="text-3xl font-bold text-amber-400"><%= @pending_games %></div>
      <div class="text-slate-400 text-sm">Pending Games</div>
    </div>
    <div class="bg-slate-800/50 rounded-xl p-6 border border-slate-700">
      <div class="text-3xl font-bold text-rose-400"><%= @pending_reports %></div>
      <div class="text-slate-400 text-sm">Pending Reports</div>
    </div>
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    <%# Recent Games %>
    <div class="bg-slate-800/50 rounded-xl border border-slate-700 overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-700">
        <h2 class="text-lg font-semibold">Recent Games</h2>
        <%= link_to "View All", admin_games_path, class: "text-sm text-violet-400 hover:text-violet-300" %>
      </div>
      <div class="divide-y divide-slate-700">
        <% @recent_games.each do |game| %>
          <div class="px-6 py-4 flex items-center justify-between">
            <div>
              <div class="font-medium text-white"><%= game.title %></div>
              <div class="text-sm text-slate-400">
                by <%= game.creator&.username || "Anonymous" %>
                <span class="mx-1">•</span>
                <%= time_ago_in_words(game.created_at) %> ago
              </div>
            </div>
            <span class="px-2 py-1 text-xs rounded-full
              <%= case game.status
                  when 'approved' then 'bg-emerald-500/20 text-emerald-400'
                  when 'pending' then 'bg-amber-500/20 text-amber-400'
                  when 'rejected' then 'bg-rose-500/20 text-rose-400'
                  when 'archived' then 'bg-slate-500/20 text-slate-400'
                  else 'bg-slate-500/20 text-slate-400'
                  end %>">
              <%= game.status %>
            </span>
          </div>
        <% end %>
        <% if @recent_games.empty? %>
          <div class="px-6 py-8 text-center text-slate-500">No games yet</div>
        <% end %>
      </div>
    </div>

    <%# Pending Reports %>
    <div class="bg-slate-800/50 rounded-xl border border-slate-700 overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-700">
        <h2 class="text-lg font-semibold">Pending Reports</h2>
        <%= link_to "View All", admin_reports_path, class: "text-sm text-violet-400 hover:text-violet-300" %>
      </div>
      <div class="divide-y divide-slate-700">
        <% @recent_reports.each do |report| %>
          <div class="px-6 py-4">
            <div class="flex items-center justify-between mb-1">
              <span class="font-medium text-white"><%= report.game.title %></span>
              <span class="px-2 py-1 text-xs rounded-full bg-rose-500/20 text-rose-400">
                <%= report.reason %>
              </span>
            </div>
            <div class="text-sm text-slate-400">
              Reported by <%= report.user.username %>
              <span class="mx-1">•</span>
              <%= time_ago_in_words(report.created_at) %> ago
            </div>
            <% if report.description.present? %>
              <div class="mt-2 text-sm text-slate-300 bg-slate-700/50 rounded p-2">
                <%= truncate(report.description, length: 100) %>
              </div>
            <% end %>
          </div>
        <% end %>
        <% if @recent_reports.empty? %>
          <div class="px-6 py-8 text-center text-slate-500">No pending reports</div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Quick Actions %>
  <div class="mt-8 flex gap-4">
    <%= link_to admin_games_path(status: "pending"), class: "px-4 py-2 bg-amber-500/20 text-amber-400 rounded-lg hover:bg-amber-500/30 transition" do %>
      Review Pending Games (<%= @pending_games %>)
    <% end %>
    <%= link_to admin_reports_path(status: "pending"), class: "px-4 py-2 bg-rose-500/20 text-rose-400 rounded-lg hover:bg-rose-500/30 transition" do %>
      Handle Reports (<%= @pending_reports %>)
    <% end %>
  </div>
</div>
