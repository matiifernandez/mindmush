<div class="container mx-auto px-4 py-10 max-w-5xl">
  <%# Profile Header %>
  <div class="bg-slate-800/50 rounded-2xl p-8 border border-slate-700/50 mb-8">
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
      <%# Avatar %>
      <div class="w-24 h-24 bg-gradient-to-br from-rose-500 to-violet-500 rounded-2xl flex items-center justify-center text-4xl font-bold text-white shadow-lg">
        <%= @user.username[0].upcase %>
      </div>

      <%# Info %>
      <div class="flex-1 text-center sm:text-left">
        <h1 class="text-3xl font-bold text-slate-100 mb-1"><%= @user.username %></h1>
        <p class="text-slate-400 mb-4">Joined <%= time_ago_in_words(@user.created_at) %> ago</p>

        <%# Stats %>
        <div class="flex flex-wrap justify-center sm:justify-start gap-6">
          <div class="text-center">
            <div class="text-2xl font-bold text-rose-400"><%= number_with_delimiter(@user.total_score) %></div>
            <div class="text-sm text-slate-400">Total Points</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-violet-400"><%= @user.games_played %></div>
            <div class="text-sm text-slate-400">Games Played</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-emerald-400"><%= @user.games_created %></div>
            <div class="text-sm text-slate-400">Games Created</div>
          </div>
        </div>
      </div>

      <% if @is_own_profile %>
        <div class="text-sm text-slate-500 bg-slate-700/50 px-3 py-1 rounded-lg">
          Your Profile
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <%# Created Games %>
    <div>
      <h2 class="text-xl font-bold text-slate-100 mb-4 flex items-center gap-2">
        <span>🎮</span> Created Games
      </h2>

      <% if @created_games.any? %>
        <div class="space-y-3">
          <% @created_games.each do |game| %>
            <%= link_to game_path(game.slug), class: "block bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 hover:border-rose-500/50 transition-all" do %>
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="font-semibold text-slate-100 mb-1"><%= game.title %></h3>
                  <p class="text-sm text-slate-400 line-clamp-1"><%= game.description.presence || "No description" %></p>
                </div>
                <div class="text-right text-sm">
                  <div class="text-slate-500">▶ <%= game.play_count %></div>
                  <div class="text-emerald-400">👍 <%= game.likes_count %></div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="bg-slate-800/30 rounded-xl p-8 text-center border border-slate-700/50">
          <div class="text-3xl mb-2">🎨</div>
          <p class="text-slate-500">
            <% if @is_own_profile %>
              You haven't created any games yet.
              <%= link_to "Create one!", generator_path, class: "text-violet-400 hover:underline" %>
            <% else %>
              No games created yet.
            <% end %>
          </p>
        </div>
      <% end %>
    </div>

    <%# Recent Activity %>
    <div>
      <h2 class="text-xl font-bold text-slate-100 mb-4 flex items-center gap-2">
        <span>🏆</span> Recent Activity
      </h2>

      <% if @recent_sessions.any? %>
        <div class="space-y-3">
          <% @recent_sessions.each do |session| %>
            <% next unless session.game %>
            <%= link_to game_path(session.game.slug), class: "block bg-slate-800/50 rounded-xl p-4 border border-slate-700/50 hover:border-violet-500/50 transition-all" do %>
              <div class="flex justify-between items-center">
                <div>
                  <h3 class="font-semibold text-slate-100"><%= session.game.title %></h3>
                  <p class="text-sm text-slate-500"><%= time_ago_in_words(session.created_at) %> ago</p>
                </div>
                <div class="text-right">
                  <div class="text-xl font-bold text-rose-400"><%= number_with_delimiter(session.score) %></div>
                  <div class="text-xs text-slate-500">points</div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="bg-slate-800/30 rounded-xl p-8 text-center border border-slate-700/50">
          <div class="text-3xl mb-2">🎯</div>
          <p class="text-slate-500">
            <% if @is_own_profile %>
              No games played yet.
              <%= link_to "Play one!", games_path, class: "text-rose-400 hover:underline" %>
            <% else %>
              No recent activity.
            <% end %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
