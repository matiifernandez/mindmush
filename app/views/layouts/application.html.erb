<!DOCTYPE html>
<html>
  <head>
    <title>MindMush</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# PWA meta-tags %>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#e94560">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">
    <%# Header %>
    <header class="bg-slate-900/80 backdrop-blur-sm border-b border-slate-800 sticky top-0 z-50">
      <nav class="container mx-auto px-4 py-3">
        <div class="flex items-center justify-between">
          <%# Logo %>
          <%= link_to root_path, class: "flex items-center gap-2 group" do %>
            <span class="text-3xl group-hover:scale-110 transition-transform">🧠</span>
            <span class="text-xl font-bold">
              <span class="text-rose-400">Mind</span><span class="text-violet-400">Mush</span>
            </span>
          <% end %>

          <%# Right Side Actions %>
          <div class="flex items-center gap-3">
            <%= link_to games_path, class: "text-slate-300 hover:text-white transition px-3 py-2 rounded-lg hover:bg-slate-800" do %>
              🎮 Browse
            <% end %>

            <% if user_signed_in? %>
              <%= link_to generator_path, class: "px-4 py-2 bg-gradient-to-r from-rose-500 to-violet-500 text-white font-medium rounded-lg hover:from-rose-600 hover:to-violet-600 transition-all hover:scale-105" do %>
                ✨ Create
              <% end %>

              <div class="flex items-center gap-2 ml-2 pl-3 border-l border-slate-700">
                <div class="text-right">
                  <div class="text-sm font-medium text-slate-200"><%= current_user.username %></div>
                  <div class="text-xs text-rose-400 font-semibold"><%= number_with_delimiter(current_user.total_score) %> pts</div>
                </div>
                <%= button_to destroy_user_session_path, method: :delete, class: "p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                <% end %>
              </div>
            <% else %>
              <%= link_to "Login", new_user_session_path, class: "text-slate-300 hover:text-white transition px-3 py-2" %>
              <%= link_to new_user_registration_path, class: "px-4 py-2 bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white font-medium rounded-lg hover:from-violet-600 hover:to-fuchsia-600 transition-all hover:scale-105" do %>
                Sign up
              <% end %>
            <% end %>
          </div>
        </div>
      </nav>
    </header>

    <%# Flash Messages %>
    <% if notice.present? %>
      <div class="bg-emerald-500/90 text-white px-4 py-3 text-center font-medium">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="bg-rose-500/90 text-white px-4 py-3 text-center font-medium">
        <%= alert %>
      </div>
    <% end %>

    <%# Main Content %>
    <main class="flex-1">
      <%= yield %>
    </main>

    <%# Footer %>
    <footer class="bg-slate-900 border-t border-slate-800 py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-slate-500">
          <span class="text-rose-400">Mind</span><span class="text-violet-400">Mush</span>
          <span class="mx-2">•</span>
          AI-powered mini games
        </p>
      </div>
    </footer>
  </body>
</html>
